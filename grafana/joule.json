{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping Joule's /metrics endpoint.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["joule", "energy", "llm"],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "Joule — LLM Energy",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Energy (last 6h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "joule", "decimals": 1 } },
      "targets": [
        { "expr": "sum(increase(joule_energy_joules_total[6h]))", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Energy saved (last 6h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "joule", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [
        { "expr": "sum(increase(joule_energy_saved_joules_total[6h]))", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Cache hit ratio",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1 } },
      "targets": [
        { "expr": "sum(rate(joule_cache_hits_total[5m])) / clamp_min(sum(rate(joule_requests_total[5m])), 1e-9)", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "CO2 (last 6h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "mass:g", "decimals": 2 } },
      "targets": [
        { "expr": "sum(increase(joule_co2_grams_total[6h]))", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Energy rate by model (J/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "watt" } },
      "targets": [
        { "expr": "rate(joule_energy_joules_total[5m])", "legendFormat": "{{model}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by status (req/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "expr": "sum by (status) (rate(joule_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by model",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, model) (rate(joule_latency_seconds_bucket[5m])))", "legendFormat": "{{model}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cost rate ($/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        { "expr": "rate(joule_cost_usd_total[5m])", "legendFormat": "{{model}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Grid carbon intensity by region (gCO2/kWh)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "targets": [
        { "expr": "joule_grid_intensity_gco2_kwh", "legendFormat": "{{region}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Circuit breaker open & retries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "targets": [
        { "expr": "joule_circuit_open", "legendFormat": "open {{provider}}", "refId": "A" },
        { "expr": "rate(joule_upstream_retries_total[5m])", "legendFormat": "retries/s {{provider}}", "refId": "B" }
      ]
    }
  ]
}
